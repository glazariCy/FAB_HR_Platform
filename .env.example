# Copy this file to .env (in the project root) and fill in the API keys from the case study email.
# .env is git-ignored, so the real keys are never committed.
VITE_API_BASE_URL=https://zalexinc.azure-api.net
# Used for POST /request-certificate
VITE_PRIMARY_API_KEY=your-primary-api-key
# Used for GET /request-list
VITE_SECONDARY_API_KEY=your-secondary-api-key
